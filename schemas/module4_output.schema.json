{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "module4_output",
  "description": "Rescue-strategy ranking and trial simulation. Consumes handoff.module4 from module1_output.json. Contains no probability that a rescue will succeed; strategies are placed in visible tiers and simulated power is always conditional on the stated assumptions.",
  "type": "object",
  "required": ["schema_version", "asset", "target", "endpoint", "inputs", "assumptions", "designs", "calibration", "requirements", "strategies"],
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "asset": {"type": "string"},
    "target": {"type": "string"},
    "disease": {"type": ["string", "null"]},
    "endpoint": {"type": "string", "description": "Endpoint the hazard ratios refer to, from module 1."},

    "inputs": {
      "type": "object",
      "description": "Verbatim copy of handoff.module4, so the run is reproducible from this file alone.",
      "required": ["hr_pos", "hr_neg"],
      "properties": {
        "endpoint": {"type": "string"},
        "hr_pos": {"type": "number", "exclusiveMinimum": 0},
        "hr_neg": {"type": "number", "exclusiveMinimum": 0},
        "itt_reference_hr": {"type": ["number", "null"]},
        "failed_trial_itt_hr": {"type": ["number", "null"]},
        "responder_fraction_sweep": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "failed_trial_n": {"type": ["integer", "null"]},
        "rescue_trial_n": {"type": ["integer", "null"]}
      }
    },

    "assumptions": {
      "type": "object",
      "description": "Human-supplied simulation inputs. None of these is derived from a model score or converted from a hazard ratio.",
      "required": ["control_median_months", "control_median_source", "follow_up_months", "alpha_one_sided", "n_simulations", "seed", "notes"],
      "properties": {
        "control_median_months": {"type": "number", "exclusiveMinimum": 0},
        "control_median_source": {"type": "string"},
        "follow_up_months": {"type": "number", "exclusiveMinimum": 0},
        "accrual_months": {"type": "number", "minimum": 0},
        "alpha_one_sided": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
        "allocation_ratio": {"type": "number", "exclusiveMinimum": 0},
        "n_simulations": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"},
        "notes": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },

    "designs": {
      "type": "array",
      "description": "Simulated power for each design at each responder fraction and sample size.",
      "items": {
        "type": "object",
        "required": ["design", "total_randomized", "simulated_power", "monte_carlo_se", "expected_screened"],
        "properties": {
          "design": {"enum": ["unselected", "enriched", "clinical_surrogate", "homogeneous"]},
          "total_randomized": {"type": "integer", "minimum": 1},
          "responder_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "simulated_power": {"type": "number", "minimum": 0, "maximum": 1},
          "monte_carlo_se": {"type": "number", "minimum": 0},
          "expected_screened": {"type": "integer", "minimum": 0},
          "mean_events": {"type": "number", "minimum": 0},
          "hr_positive": {"type": "number"},
          "hr_negative": {"type": ["number", "null"]},
          "n_simulations": {"type": "integer", "minimum": 1}
        }
      }
    },

    "calibration": {
      "type": "object",
      "description": "Directional check that the simulator reproduces the failed trial's miss and the rescue trial's win.",
      "required": ["failed_trial", "rescue_trial", "ordering_reproduced", "caveat"],
      "properties": {
        "failed_trial": {"type": "object"},
        "rescue_trial": {"type": "object"},
        "ordering_reproduced": {"type": "boolean"},
        "caveat": {"type": "string"}
      }
    },

    "requirements": {
      "type": "object",
      "description": "What a redesigned trial would need.",
      "required": ["min_fraction_for_target_power", "enriched_design"],
      "properties": {
        "target_power": {"type": "number"},
        "min_fraction_for_target_power": {
          "type": "object",
          "description": "Smallest responder fraction at which an unselected trial of the stated size reaches target power; fraction is null when no fraction suffices.",
          "required": ["n_total", "target_power", "fraction"],
          "properties": {
            "n_total": {"type": "integer"},
            "target_power": {"type": "number"},
            "fraction": {"type": ["number", "null"]},
            "note": {"type": "string"}
          }
        },
        "enriched_design": {
          "type": "object",
          "required": ["n_randomized", "expected_screened", "target_power"],
          "properties": {
            "n_randomized": {"type": ["integer", "null"]},
            "expected_screened": {"type": ["integer", "null"]},
            "simulated_power": {"type": ["number", "null"]},
            "target_power": {"type": "number"},
            "responder_fraction": {"type": "number"},
            "note": {"type": "string"}
          }
        }
      }
    },

    "strategies": {
      "type": "array",
      "minItems": 1,
      "description": "Ranked rescue strategies. Tier is set by evidence strength recorded in module 1, never by plausibility, and no numeric probability of rescue is emitted.",
      "items": {
        "type": "object",
        "required": ["strategy", "tier", "rank", "module1_evidence", "next_experiment", "would_be_undermined_by"],
        "properties": {
          "strategy": {"type": "string"},
          "tier": {
            "enum": [
              "tier_1_clinical_evidence_in_this_asset",
              "tier_2_clinical_evidence_indirect",
              "tier_3_mechanistic_or_model_only",
              "tier_4_not_supported_by_available_evidence"
            ]
          },
          "rank": {"type": "integer", "minimum": 1},
          "used_historically": {"type": ["boolean", "null"]},
          "module1_evidence": {"type": "string"},
          "supporting_rules": {"type": "array", "items": {"type": "string"}},
          "design_consequence": {"type": ["object", "null"]},
          "next_experiment": {"type": "string"},
          "would_be_undermined_by": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },

    "figures": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
